{
  "name": "workflow-app",
  "version": "0.1.0",
  "private": true,
  "description": "SaaS de operações para pequenas agências, desenvolvido como projeto full-stack de portfólio.",
  "author": "Thalles Leal Tavares",
  "license": "MIT",
  "homepage": "https://workflow-app-lac.vercel.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/Thalles714/workflow-app.git"
  },
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e:preflight": "node scripts/check-e2e-services.mts",
    "test:e2e": "pnpm test:e2e:preflight && playwright test",
    "test:e2e:smoke": "pnpm test:e2e:preflight && playwright test tests/e2e/auth-smoke.spec.ts",
    "test:e2e:public:preflight": "node scripts/check-e2e-services.mts --public",
    "test:e2e:public": "pnpm test:e2e:public:preflight && playwright test tests/e2e/public-demo.spec.ts tests/e2e/health.spec.ts",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local",
    "db:test": "vitest run src/server/database",
    "demo:verify-seed": "node scripts/verify-demo-seed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.2",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "simplex-noise": "^4.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "prettier": "3.9.6",
    "supabase": "2.112.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
